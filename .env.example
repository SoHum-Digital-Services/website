# --- Existing (contact form) ---
RESEND_API_KEY=

# --- Dashboard auth ---
# Any password you choose for the /dashboard ops page.
DASHBOARD_PASSWORD=
# Random secret used to sign the session cookie. Generate with: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=

# --- Vercel (deploy status per project) ---
# vercel.com -> Account Settings -> Tokens -> Create Token, scoped to the team.
VERCEL_API_TOKEN=

# --- Supabase (status for gativani + chanttracker) ---
# supabase.com/dashboard/account/tokens -> Generate new token.
SUPABASE_ACCESS_TOKEN=

# --- MongoDB Atlas (spjrsd database stats) ---
# A read-only user's connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
